-	.key_len		= sizeof_field(struct kern_ipc_perm, key),
-	.automatic_shrinking	= true,
-};
+/*
+ * [KEY-INDEX] 不用内核的 rhashtable 做 key 索引。
+ *
+ * 原因：struct ipc_namespace 是我们自己 kzalloc 的，大小按**编译期**
+ * sizeof() 算；而 rhashtable_init() / rhashtable_insert_slow() 是内核里的
+ * 函数，它们按**内核的** struct rhashtable 布局去初始化嵌在 ids[] 里的
+ * key_ht。目标内核的 struct rhashtable 一旦比构建时大，这次初始化就写穿
+ * 了我们自己的结构体 —— 堆破坏，表现为随机 panic 或者直接卡死，而且现场
+ * 离肇事点很远，极难定位。
+ *
+ * Dere3046/_patchHarmony 在 6.1.145 MT6989 上撞的就是这个：module 里
+ * ipc_namespace 比设备小 0x18 字节（sizeof(ipc_ids) 272 vs 280）×3，
+ * 他们的修法是让模块不再引用任何 rhashtable 符号（nm -u 归零）。
+ *
+ * 我们的 IPC 对象全部由本模块自己分配、自己使用，内核从不接触，所以用一条
+ * 私有单链表代替哈希就够了：key 查找退化成线性扫描，容器里 SysV IPC 对象
+ * 数量很小，完全够用，换来的是对内核布局完全不敏感。
+ *
+ * key_ht 那段内存至少有一个指针大小，拿它的头 8 字节当链表头用。
+ */
+static inline struct rhash_head **ipc_keylist_head(struct ipc_ids *ids)
+{
+	return (struct rhash_head **)&ids->key_ht;
+}
+
+static struct kern_ipc_perm *ipc_keylist_lookup(struct ipc_ids *ids, key_t key)
+{
+	struct rhash_head *p;
+
+	for (p = *ipc_keylist_head(ids); p; p = p->next) {
+		struct kern_ipc_perm *ipcp =
+			container_of(p, struct kern_ipc_perm, khtnode);
+
+		if (ipcp->key == key)
+			return ipcp;
+	}
+	return NULL;
+}
+
+static void ipc_keylist_insert(struct ipc_ids *ids, struct kern_ipc_perm *ipcp)
+{
+	struct rhash_head **head = ipc_keylist_head(ids);
+
+	ipcp->khtnode.next = *head;
+	*head = &ipcp->khtnode;
+}
+
+static void ipc_keylist_unlink(struct ipc_ids *ids, struct kern_ipc_perm *ipcp)
+{
+	struct rhash_head **pp = ipc_keylist_head(ids);
+
+	while (*pp) {
+		if (*pp == &ipcp->khtnode) {
+			*pp = ipcp->khtnode.next;
+			ipcp->khtnode.next = NULL;
+			return;
+		}
+		pp = &(*pp)->next;
+	}
+}
+
+/* 给 msg/sem/shm 的销毁路径用 */
+void ipc_keylist_clear(struct ipc_ids *ids)
+{
+	*ipc_keylist_head(ids) = NULL;
+}
 
