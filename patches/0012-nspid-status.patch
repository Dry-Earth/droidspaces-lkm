+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * vendor_kernel_status.c - add the NStgid/NSpid/NSpgid/NSsid block that
+ * CONFIG_PID_NS=n compiles out of proc_pid_status().
+ *
+ * Droidspaces identifies a container init by the last field of
+ * /proc/<pid>/status NSpid.  Without CONFIG_PID_NS the kernel prints the
+ * whole block nowhere, even when a real (vendored) pid_namespace is in
+ * play, so the app concludes the container is not running.
+ *
+ * The block is rebuilt from struct pid->numbers[] exactly like
+ * fs/proc/array.c does when CONFIG_PID_NS is enabled.
+ */
+#include <linux/kernel.h>
+#include <linux/errno.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/pid.h>
+#include <linux/pid_namespace.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+
+#include "../vendor/vendor_kernel.h"
+#include "lkm4ctr_log.h"
+#include "shadow_hook.h"
+
+static int (*real_proc_pid_status)(struct seq_file *m,
+				   struct pid_namespace *ns, struct pid *pid,
+				   struct task_struct *task);
+static void (*vns_seq_puts_fn)(struct seq_file *m, const char *s);
+static void (*vns_seq_putc_fn)(struct seq_file *m, char c);
+static void (*vns_seq_dec_fn)(struct seq_file *m, const char *delimiter,
+			      unsigned long long num);
+static pid_t (*vns_task_pid_nr_ns_fn)(struct task_struct *task,
+				      enum pid_type type,
+				      struct pid_namespace *ns);
+static bool vns_status_resolved;
+
+static const char * const vendor_kernel_proc_pid_status_names[] = {
+	"proc_pid_status", NULL,
+};
+
+static void vns_status_resolve(void)
+{
+	if (READ_ONCE(vns_status_resolved))
+		return;
+
+	vns_seq_puts_fn = (void *)shadow_hook_resolve("seq_puts");
+	if (!vns_seq_puts_fn)
+		vns_seq_puts_fn = (void *)shadow_hook_resolve("__seq_puts");
+	vns_seq_putc_fn = (void *)shadow_hook_resolve("seq_putc");
+	vns_seq_dec_fn = (void *)shadow_hook_resolve("seq_put_decimal_ull");
+	vns_task_pid_nr_ns_fn =
+		(void *)shadow_hook_resolve("__task_pid_nr_ns");
+
+	WRITE_ONCE(vns_status_resolved, true);
+}
+
+static __nocfi noinline void vns_ns_lines(struct seq_file *m,
+					  struct task_struct *task,
+					  struct pid *pid, enum pid_type type,
+					  int from, int to)
+{
+	int g;
+
+	for (g = from; g <= to; g++)
+		vns_seq_dec_fn(m, "\t",
+			       (unsigned long long)vns_task_pid_nr_ns_fn(
+				       task, type, pid->numbers[g].ns));
+}
+
+static __nocfi noinline int vendor_kernel_hook_proc_pid_status(
+	struct seq_file *m, struct pid_namespace *ns, struct pid *pid,
+	struct task_struct *task)
+{
+	int ret;
+	int from, to;
+
+	ret = real_proc_pid_status(m, ns, pid, task);
+	if (ret || !task || !pid)
+		return ret;
+
+	vns_status_resolve();
+	if (!vns_seq_puts_fn || !vns_seq_putc_fn || !vns_seq_dec_fn ||
+	    !vns_task_pid_nr_ns_fn)
+		return ret;
+
+	from = READ_ONCE(ns->level);
+	to = READ_ONCE(pid->level);
+	if (to <= from)
+		return ret;
+
+	vns_seq_puts_fn(m, "\nNStgid:");
+	vns_ns_lines(m, task, pid, PIDTYPE_TGID, from, to);
+	vns_seq_puts_fn(m, "\nNSpid:");
+	vns_ns_lines(m, task, pid, PIDTYPE_PID, from, to);
+	vns_seq_puts_fn(m, "\nNSpgid:");
+	vns_ns_lines(m, task, pid, PIDTYPE_PGID, from, to);
+	vns_seq_puts_fn(m, "\nNSsid:");
+	vns_ns_lines(m, task, pid, PIDTYPE_SID, from, to);
+	vns_seq_putc_fn(m, '\n');
+
+	return ret;
+}
+
+struct shadow_hook vendor_kernel_proc_pid_status_hook =
+	SHADOW_HOOK(vendor_kernel_proc_pid_status_names,
+		    vendor_kernel_hook_proc_pid_status, &real_proc_pid_status);
