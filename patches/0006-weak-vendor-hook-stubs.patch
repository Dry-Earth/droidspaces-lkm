diff --git a/glue/vendor_hook_stubs.c b/glue/vendor_hook_stubs.c
new file mode 100644
index 0000000..012e436
--- /dev/null
+++ b/glue/vendor_hook_stubs.c
@@ -0,0 +1,82 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Android vendor hook 的弱定义。
+ *
+ * 背景
+ * ----
+ * Android 的 percpu-rwsem 争用计时是通过 vendor hook 做的：
+ *
+ *     call_android_vh_record_pcpu_rwsem_starttime(tsk, settime);
+ *
+ * 这个宏在内核头文件里展开成 `_trace_android_vh_record_pcpu_rwsem_starttime(...)`。
+ * 多数 GKI 内核会导出它，但有些精简构建不会 —— 那样我们的模块 insmod 时会报
+ * `Unknown symbol _trace_android_vh_record_pcpu_rwsem_starttime`，整个模块装不上。
+ *
+ * 这里给弱定义：内核导出了就用内核的，没导出就用这个空实现。这两个 hook 只用于
+ * rwsem 争用时间统计，空实现不改变任何锁语义。
+ *
+ * 为什么不能只写一份签名
+ * ----------------------
+ * 这些 hook 的**签名和存在性都随内核版本变**，写死一份必然在某代上编译报
+ * `conflicting types`：
+ *
+ *   内核       starttime                    time_early              rdheld_starttime
+ *   ≤6.1       (task_struct *, ulong)       (ulong, percpu_rwsem *)  —
+ *   6.6        (percpu_rwsem *, ulong)      已移除                   新增
+ *   6.12       (percpu_rwsem *, ulong)      已移除                   已移除
+ *
+ * 之前只按 ≤6.1 的签名写，结果 android15-6.6 和 android16-6.12 的 lkm4ctr
+ * **从来没编译成功过** —— 而且构建脚本当时容忍部分模块失败，所以这个缺口一直
+ * 被埋着，直到加上「8 个模块一个都不能少」的检查才暴露出来。
+ *
+ * 签名来源：AOSP kernel/common 的 include/trace/hooks/dtask.h，三个分支逐一核对。
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/percpu-rwsem.h>
+#include <linux/types.h>
+#include <linux/version.h>
+
+/*
+ * starttime：6.6 起第一个参数从 task_struct * 变成 percpu_rw_semaphore *。
+ * 用 __weak 给出与内核声明**完全一致**的弱定义，否则编译器报 conflicting types。
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+__weak void _trace_android_vh_record_pcpu_rwsem_starttime(
+		struct percpu_rw_semaphore *sem, unsigned long settime_jiffies)
+{
+	/* 只影响争用计时统计，空实现不改变锁语义 */
+}
+#else
+__weak void _trace_android_vh_record_pcpu_rwsem_starttime(
+		struct task_struct *tsk, unsigned long settime_jiffies)
+{
+}
+#endif
+
+/*
+ * time_early：6.6 起被内核移除。只在 6.6 之前定义，否则新内核上会是一个
+ * 没有任何声明的多余符号（不报错，但没意义）。
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 6, 0)
+__weak void _trace_android_vh_record_pcpu_rwsem_time_early(
+		unsigned long settime_jiffies, struct percpu_rw_semaphore *sem)
+{
+}
+#endif
+
+/*
+ * rdheld_starttime：只有 6.6 这一代有（6.12 又删掉了）。
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0) && \
+    LINUX_VERSION_CODE < KERNEL_VERSION(6, 12, 0)
+__weak void _trace_android_vh_record_pcpu_rwsem_rdheld_starttime(
+		struct percpu_rw_semaphore *sem, unsigned long settime_jiffies)
+{
+}
+#endif
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("weak definitions for Android vendor hooks the vendored rwsem code calls");
\ No newline at end of file
