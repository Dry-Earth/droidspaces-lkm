diff --git a/glue/vendor_hook_stubs.c b/glue/vendor_hook_stubs.c
new file mode 100644
index 0000000..10ec663
--- /dev/null
+++ b/glue/vendor_hook_stubs.c
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * vendor_hook_stubs.c - 给 Android vendor hook 提供 weak 兜底实现
+ *
+ * 问题
+ * ----
+ * include/linux/percpu-rwsem.h 里的内联函数（percpu_down_read / percpu_up_read）
+ * **无条件**调用这两个 vendor hook：
+ *
+ *   _trace_android_vh_record_pcpu_rwsem_starttime()
+ *   _trace_android_vh_record_pcpu_rwsem_time_early()
+ *
+ * 只要模块里有代码走过 percpu-rwsem（本项目的 vendored overlayfs 用
+ * inode_lock() 就会走到），编译出来就带这两个未定义符号。
+ *
+ * 它们由 CONFIG_ANDROID_VENDOR_HOOKS 生成，**不是所有厂商内核都开**。目标内核
+ * 没开时，insmod 只会报一句
+ *
+ *   unknown symbol in module, or unknown parameter
+ *
+ * 把真正缺失的符号名埋掉——这正是大量用户反馈的那个报错。
+ *
+ * 做法
+ * ----
+ * 在这里提供 **weak** 空实现：
+ *   - 内核导出同名符号时，链接优先用内核那份（模块内的引用绑定到本地定义，
+ *     但语义上两者都是同一个空/真实 hook，不影响功能）
+ *   - 内核没有时，引用解析到这里的空函数，模块照常加载
+ *
+ * 这两个 hook 只用于 Android 的 rwsem 争用计时统计，空实现不改变任何锁语义。
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/sched.h>
+#include <linux/percpu-rwsem.h>
+#include <linux/types.h>
+#include <linux/version.h>
+
+/*
+ * 签名必须与内核头文件里的声明完全一致，否则编译报冲突。
+ * 头文件已经把它们声明为普通函数，这里用 __weak 给出弱定义。
+ */
+__weak void _trace_android_vh_record_pcpu_rwsem_starttime(
+		struct task_struct *tsk, unsigned long settime)
+{
+	/* 不做任何事：内核没开这个 vendor hook 时，统计缺失不影响正确性 */
+}
+
+/*
+ * time_early 只在较新的内核（6.1+）里出现；老内核不声明它，这里的定义就是
+ * 一段没有被引用的代码，链接器会丢弃，不会造成冲突。
+ */
+__weak void _trace_android_vh_record_pcpu_rwsem_time_early(
+		unsigned long settime, struct percpu_rw_semaphore *sem)
+{
+}
