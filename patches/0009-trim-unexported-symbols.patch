 /*
  * [BUILD-COMPAT] logfc (fs/fs_context.c). Genuinely EXPORT_SYMBOL'd on
@@ -181,3 +154,102 @@ void logfc(struct fc_log *log, const char *prefix, char level, const char *fmt,
 }
 
 #endif /* LINUX_VERSION_CODE in [5.10, 6.19) */
+
+
+/* ---------------- [TRIM] 两个不导出符号的实现 ---------------- */
+
+/*
+ * file_remove_privs：file.c 用它清掉 S_ISUID/S_ISGID 之类的特权位。
+ * 厂商内核可能不导出（issue #2 实测 Meizu 6.1.25 就没有）。
+ */
+int (*vns_file_remove_privs_ptr)(struct file *file);
+
+void vns_file_remove_privs_resolve(void)
+{
+	static bool done;
+	int (*fn)(struct file *);
+
+	if (done)
+		return;
+	done = true;
+
+	fn = (int (*)(struct file *))shadow_hook_resolve("file_remove_privs");
+	if (!fn)
+		LKM4CTR_WARN("vendor_kernel",
+			     "file_remove_privs 未解析到；overlayfs 跳过特权位清理");
+	vns_file_remove_privs_ptr = fn;
+}
+
+/*
+ * 6.1 之前 seq_escape 是真函数：本地提供同名定义，模块里就没有对它的
+ * undefined 引用。6.1 及以后它变成内联，由 vns_trim_shims.h 把
+ * seq_escape_mem 换成下面那个实现。
+ */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 1, 0)
+void seq_escape(struct seq_file *m, const char *s, const char *esc)
+{
+	char c;
+
+	while ((c = *s++) != '\0') {
+		if (!strchr(esc, c)) {
+			seq_putc(m, c);
+			continue;
+		}
+		switch (c) {
+		case '\n':
+			seq_puts(m, "\\n");
+			break;
+		case '\t':
+			seq_puts(m, "\\t");
+			break;
+		case '\\':
+			seq_puts(m, "\\\\");
+			break;
+		default:
+			seq_putc(m, '\\');
+			seq_putc(m, '0' + ((unsigned char)c >> 6));
+			seq_putc(m, '0' + (((unsigned char)c >> 3) & 7));
+			seq_putc(m, '0' + ((unsigned char)c & 7));
+		}
+	}
+}
+#else
+/*
+ * seq_escape_mem 的本地实现。签名取自 linux v6.1 include/linux/seq_file.h:
+ *   void seq_escape_mem(struct seq_file *m, const char *src, size_t len,
+ *                       unsigned int flags, const char *esc);
+ *
+ * flags 里 overlayfs 只用 ESCAPE_OCTAL（=0）。其余 flag 位这里不区分 ——
+ * 本模块只有 params.c 的 seq_show_option 会走到，那条路径永远是 OCTAL。
+ */
+void lkm4ctr_seq_escape_mem(struct seq_file *m, const char *src, size_t len,
+			    unsigned int flags, const char *esc)
+{
+	(void)flags;
+
+	while (len--) {
+		unsigned char c = (unsigned char)*src++;
+
+		if (!esc || !strchr(esc, c)) {
+			seq_putc(m, c);
+			continue;
+		}
+		switch (c) {
+		case '\n':
+			seq_puts(m, "\\n");
+			break;
+		case '\t':
+			seq_puts(m, "\\t");
+			break;
+		case '\\':
+			seq_puts(m, "\\\\");
+			break;
+		default:
+			seq_putc(m, '\\');
+			seq_putc(m, '0' + (c >> 6));
+			seq_putc(m, '0' + ((c >> 3) & 7));
+			seq_putc(m, '0' + (c & 7));
+		}
+	}
+}
+#endif
diff --git a/glue/vns_trim_shims.h b/glue/vns_trim_shims.h
new file mode 100644
index 0000000..19dd1d9
--- /dev/null
+++ b/glue/vns_trim_shims.h
@@ -0,0 +1,57 @@
+/* Public Domain since creation (AI-generated; no copyright subsists; not CC0). */
+/*
+ * vns_trim_shims.h - 把两个在部分厂商内核上不导出的符号转成运行时解析 / 本地实现。
+ *
+ * 为什么不加进 vendor_kernel_ovl_vfs_compat.h：
+ * 那个头会把几十个 VFS 调用一起重定向，而 file.c / params.c 现在完全没被它
+ * 覆盖。把整个兼容头塞进这两个文件，等于一次性改变它们的全部调用面，
+ * 编译面太大。这里只动真正需要动的那两个符号。
+ */
+#ifndef _VNS_TRIM_SHIMS_H
+#define _VNS_TRIM_SHIMS_H
+
+#include <linux/types.h>
+#include <linux/version.h>
+
+struct file;
+struct seq_file;
+
+/*
+ * file_remove_privs —— file.c 直接调用，厂商内核可能没有 EXPORT_SYMBOL。
+ *
+ * 惰性解析：第一次调用才查（shadow_hook 的 kallsyms 机制必须已就绪）。
+ * 解析不到返回 0（跳过特权位清理）—— overlayfs 复制时会重新应用属性，
+ * 跳过这一步不破坏文件内容；比整个模块装不上好。
+ *
+ * #define 必须在本头被包含时内核已经声明过 file_remove_privs（即 <linux/fs.h>
+ * 之后），否则会把内核自己的声明改名。
+ */
+extern int (*vns_file_remove_privs_ptr)(struct file *file);
+extern void vns_file_remove_privs_resolve(void);
+
+static inline int vns_file_remove_privs(struct file *file)
+{
+	if (!vns_file_remove_privs_ptr)
+		vns_file_remove_privs_resolve();
+	return vns_file_remove_privs_ptr ? vns_file_remove_privs_ptr(file) : 0;
+}
+#define file_remove_privs vns_file_remove_privs
+
+/*
+ * seq_escape_mem —— 6.1 起 <linux/seq_file.h> 把 seq_escape() 做成 static
+ * inline，经 seq_escape_str() 展开成对 seq_escape_mem() 的真实调用。
+ * 那个函数是 EXPORT_SYMBOL 的，但厂商内核可能删掉。
+ *
+ * 换 seq_escape 没用（内联体里调的还是 seq_escape_mem），所以换它本身。
+ * 这个 #define 必须在 <linux/seq_file.h> 之前生效：头里的声明和内联体里的
+ * 调用会一起被改名，与我们下面的定义对上。
+ *
+ * 6.1 之前 seq_escape 是真函数，本地提供同名定义即可（见 .c），不需要这里介入。
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
+#define seq_escape_mem lkm4ctr_seq_escape_mem
+void lkm4ctr_seq_escape_mem(struct seq_file *m, const char *src, size_t len,
+			    unsigned int flags, const char *esc);
+#endif
+
+#endif /* _VNS_TRIM_SHIMS_H */
