diff --git a/glue/vns_trim_shims.h b/glue/vns_trim_shims.h
new file mode 100644
index 0000000..38a2bfe
--- /dev/null
+++ b/glue/vns_trim_shims.h
@@ -0,0 +1,55 @@
+/* Public Domain since creation (AI-generated; no copyright subsists; not CC0). */
+/*
+ * vns_trim_shims.h - 把两个在部分厂商内核上不导出的符号转成运行时解析。
+ *
+ * 为什么单独一个头而不是加进 vendor_kernel_ovl_vfs_compat.h：
+ * 那个头会把几十个 VFS 调用一起重定向，而 file.c / params.c 现在完全没被它
+ * 覆盖。把整个兼容头塞进这两个文件，等于一次性改变它们的全部调用面，
+ * 编译面太大。这里只动真正需要动的那两个符号。
+ *
+ *   file_remove_privs   file.c 直接调用；厂商内核可能没有 EXPORT_SYMBOL
+ *   seq_escape          6.1 起 <linux/seq_file.h> 把它做成 static inline，
+ *                       展开成 seq_escape_mem；那个函数同样可能不导出
+ *
+ * 两者的实现都在 vendor_kernel_ovl_vfs_compat.c（里面已经用 shadow_hook_resolve）。
+ */
+#ifndef _VNS_TRIM_SHIMS_H
+#define _VNS_TRIM_SHIMS_H
+
+#include <linux/types.h>
+
+struct file;
+struct seq_file;
+
+/* 解析失败时为 NULL */
+extern int (*vns_file_remove_privs_ptr)(struct file *file);
+
+/*
+ * NULL 安全的包装：解析不到时返回 0（"没有需要移除的特权位"）。
+ * 保守选择 —— overlayfs 复制时会重新应用属性，跳过这一步不破坏文件内容，
+ * 只是某些 setuid 语义要靠后续复制修正；比整个模块装不上好得多。
+ *
+ * #define 必须在这个头被包含时内核已经声明过 file_remove_privs
+ * （即 <linux/fs.h> 之后），否则会把内核的声明本身改名。
+ */
+/* 惰性解析：第一次调用时才查，避免依赖模块 init 的调用顺序
+ * （shadow_hook 的 kallsyms 机制必须已经就绪） */
+extern void vns_file_remove_privs_resolve(void);
+
+static inline int vns_file_remove_privs(struct file *file)
+{
+	if (!vns_file_remove_privs_ptr)
+		vns_file_remove_privs_resolve();
+	return vns_file_remove_privs_ptr ? vns_file_remove_privs_ptr(file) : 0;
+}
+#define file_remove_privs vns_file_remove_privs
+
+/*
+ * 只能在 #include <linux/seq_file.h> **之前** 定义。
+ * 这样 seq_file.h 里那个 static inline seq_escape() 会被改名成本函数，
+ * seq_show_option() 的内联体调用也跟着改，最终不产生 seq_escape_mem 引用。
+ */
+#define seq_escape lkm4ctr_seq_escape
+void lkm4ctr_seq_escape(struct seq_file *m, const char *s, const char *esc);
+
+#endif /* _VNS_TRIM_SHIMS_H */
