+/* kmem_cache_alloc_lru() was introduced at 6.0 (<linux/slab.h>). The MID tier
+ * spans [5.12, 6.3), so 5.15-shaped kernels have no such function at all --
+ * and listing a helper the tier's kernel lacks makes pass 1's typeof() fail
+ * with "use of undeclared identifier". It therefore needs a conditional entry
+ * rather than a plain X(...), same rule as d_tmpfile above. */
+#define VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 0, 0))
+#if VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU
+#define VNS_OVL_VFSC_KMLRU_ENTRY(X) X(kmem_cache_alloc_lru)
+#else
+#define VNS_OVL_VFSC_KMLRU_ENTRY(X)
+#endif
+
+/*
+ * kmem_cache_alloc_lru 的三种取法：
+ *
+ *   [6.0, 6.10)   普通函数 kmem_cache_alloc_lru
+ *   [6.10, ...)   宏 + kmem_cache_alloc_lru_noprof
+ *   <6.0          没有这个函数
+ *
+ * 分界点是 6.10（不是 6.12）：6.10 引入 alloc_hooks 包装，
+ * kmem_cache_alloc_lru 从此变成宏，真正的符号叫 _noprof。
+ *
+ * 三个宏是**并列**的，不是嵌套 —— 嵌套会让 HAVE 为 false 时
+ * 后面两个未定义。
+ */
+#if VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU && \
+	LINUX_VERSION_CODE < KERNEL_VERSION(6, 10, 0)
+#define VNS_OVL_VFSC_KMLRU_NO_PROF_ENTRY(X) X(kmem_cache_alloc_lru)
+#else
+#define VNS_OVL_VFSC_KMLRU_NO_PROF_ENTRY(X)
+#endif
+
+#if VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU && \
+	LINUX_VERSION_CODE >= KERNEL_VERSION(6, 10, 0)
+#define VNS_OVL_VFSC_KMLRU_PROF_ENTRY(X) X(kmem_cache_alloc_lru_noprof)
+#else
+#define VNS_OVL_VFSC_KMLRU_PROF_ENTRY(X)
+#endif
