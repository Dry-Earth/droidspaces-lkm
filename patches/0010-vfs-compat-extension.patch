+/*
+ * 下面两个只在 MID/NEW 层提供：__percpu_counter_init 和
+ * percpu_counter_destroy 只进了 MID/NEW 的兼容清单，5.10 上
+ * 它们本来就是导出的（实测 5.10 的静态导入清单里没有它们），
+ * 不需要重定向。守卫必须和清单条目一致，否则 OLD 层会引用
+ * 未声明的 vns_ovl_vfsc_* 指针。
+ */
+#if VNS_OVL_TIER_MID
+/*
+ * __percpu_counter_init / percpu_counter_destroy - same-name forwarding
+ * definitions, deliberately not #define aliases.
+ *
+ * percpu_counter_init() is a macro with CONFIG_LOCKDEP and a static inline
+ * without it (<linux/percpu_counter.h>); both spell the underlying call as
+ * __percpu_counter_init(...) and both are parsed before this header can run.
+ * A #define therefore either misses the inline body entirely or perturbs the
+ * argument shuffle -- the latter produced
+ *
+ *   failed to init default ipc namespace (-12)
+ *
+ * on the Qualcomm SM7675 device (vns_msg_accounting_init -> ENOMEM).
+ *
+ * Defining functions with the kernel's own names fixes both cases: every
+ * reference inside this module, from inline bodies and direct calls alike,
+ * links here, so no static import is emitted.
+ *
+ * Needed where a vendor kernel trims these exports (Meizu 6.1.25); harmless
+ * where they are exported (SM7675).
+ *
+ * __nocfi: the bodies make indirect calls.
+ */
+int __nocfi __percpu_counter_init(struct percpu_counter *fbc, s64 amount,
+				  gfp_t gfp, struct lock_class_key *key)
+{
+	if (!vns_ovl_vfsc___percpu_counter_init)
+		return -ENOENT;
+	return vns_ovl_vfsc___percpu_counter_init(fbc, amount, gfp, key);
+}
+
+void __nocfi percpu_counter_destroy(struct percpu_counter *fbc)
+{
+	if (vns_ovl_vfsc_percpu_counter_destroy)
+		vns_ovl_vfsc_percpu_counter_destroy(fbc);
+}
+#endif /* VNS_OVL_TIER_MID: percpu 同名函数只在 MID 提供（指针在 MID 清单里） */
+
+/*
+ * 同名转发函数（第二批）
+ *
+ * 这五个符号即使加了 #define 也仍然被静态导入，原因各不相同：
+ *
+ *   d_add / d_make_root / d_path
+ *       glue/lkm4ctr_diagfs.c 和 glue/lkm4ctr_hotreload.c 调用，那两个文件
+ *       用的是 vns_vfs_shared_syms.h（轻量头），不在 overlayfs 的 include
+ *       链上，够不到 compat 头的 #define，而轻量头原本也没收它们。
+ *
+ *   vfs_getattr_nosec
+ *       vendor/fs/overlayfs/overlayfs.h 里的 inline 函数调用。头文件在所有
+ *       .c 之前展开，那时 compat 头的 #define 还没生效。
+ *
+ *   vfs_fsync_range
+ *       vendor/fs/overlayfs/readdir.c 调用，而那个文件没被加兼容头
+ *       （只有 dir/util/export/copy_up/file 加了）。
+ *
+ * 统一改用同名函数：模块内所有引用都链到这里，不产生静态导入，也不受
+ * 宏展开顺序影响。
+ *
+ * 注意：这几条原本在 compat 头里有 #define，必须先删掉 —— 函数定义会被
+ * 对象式宏展开，变成语法错误。
+ */
+
+__nocfi void d_add(struct dentry *dentry, struct inode *inode)
+{
+	if (vns_ovl_vfsc_d_add)
+		vns_ovl_vfsc_d_add(dentry, inode);
+}
+
+__nocfi struct dentry *d_make_root(struct inode *root_inode)
+{
+	if (!vns_ovl_vfsc_d_make_root)
+		return 0;
+	return vns_ovl_vfsc_d_make_root(root_inode);
+}
+
+__nocfi char *d_path(const struct path *path, char *buf, int buflen)
+{
+	if (!vns_ovl_vfsc_d_path)
+		return 0;
+	return vns_ovl_vfsc_d_path(path, buf, buflen);
+}
+
+__nocfi int vfs_fsync_range(struct file *file, loff_t start, loff_t end, int datasync)
+{
+	if (!vns_ovl_vfsc_vfs_fsync_range)
+		return 0;
+	return vns_ovl_vfsc_vfs_fsync_range(file, start, end, datasync);
+}
+
+__nocfi int vfs_getattr_nosec(const struct path *path, struct kstat *stat, u32 request_mask, unsigned int query_flags)
+{
+	if (!vns_ovl_vfsc_vfs_getattr_nosec)
+		return 0;
+	return vns_ovl_vfsc_vfs_getattr_nosec(path, stat, request_mask, query_flags);
+}
+
+/*
+ * generic_read_dir - same-name forwarding definition, not a #define alias.
+ *
+ * The #define form works for direct calls but not where the name is taken as a
+ * function address: overlayfs puts it in a struct file_operations initialiser
+ * (".read = generic_read_dir"), and (*vns_ovl_vfsc_generic_read_dir) is not a
+ * compile-time constant there. A real function with the kernel's own name is
+ * addressable and callable both ways.
+ *
+ * Signature matches the kernel's (fs.h):
+ *   ssize_t generic_read_dir(struct file *, char __user *, size_t, loff_t *);
+ * It is the legacy read() entry that always returns -EISDIR, not the
+ * iterate_shared() form -- getting that wrong is what CI #47 caught.
+ */
+ssize_t __nocfi generic_read_dir(struct file *filp, char __user *buf,
+				 size_t count, loff_t *ppos)
+{
+	if (!vns_ovl_vfsc_generic_read_dir)
+		return -EIO;
+	return vns_ovl_vfsc_generic_read_dir(filp, buf, count, ppos);
+}
