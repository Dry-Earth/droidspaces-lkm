diff --git a/glue/vns_vfs_shared_syms.h b/glue/vns_vfs_shared_syms.h
new file mode 100644
index 0000000..6b476d6
--- /dev/null
+++ b/glue/vns_vfs_shared_syms.h
@@ -0,0 +1,113 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * vns_vfs_shared_syms.h - VFS helpers needed outside fs/overlayfs
+ *
+ * Why this exists rather than including vendor_kernel_ovl_vfs_compat.h
+ * --------------------------------------------------------------------
+ * That header assumes its includer already pulled in <linux/xattr.h>,
+ * <linux/exportfs.h>, <linux/posix_acl.h>, <linux/cred.h> and friends, because
+ * its pass-1 `extern typeof(name) *vns_ovl_vfsc_<name>;` needs every function
+ * to be declared. The fs/overlayfs sources do include that set; glue/ and
+ * vendor/ipc/ do not, and including the overlayfs header there fails with
+ * "use of undeclared identifier 'vfs_setxattr'" and similar.
+ *
+ * So this header declares only the pointers those files need, with the exact
+ * types vendor_kernel_ovl_vfs_compat.c defines them as, and aliases the bare
+ * names to them. The overlayfs layer still resolves them; nothing is resolved
+ * twice.
+ *
+ * Scope
+ * -----
+ * Guarded to the tier whose list carries these names (MID), because outside it
+ * `vns_ovl_vfsc_<name>` would not exist and the link would fail. On other tiers
+ * the calls stay ordinary static imports, which is what they were before.
+ *
+ * Naming
+ * ------
+ * Deliberately not `vns_vfs_*`: these are the overlayfs layer's storage, and
+ * keeping the `vns_ovl_vfsc_` name makes it obvious where they are defined and
+ * resolved.
+ */
+/*
+ * Functions, not macros.
+ *
+ * This header used to #define each of these names to (*vns_ovl_vfsc_<name>).
+ * That broke lkm4ctr on the Qualcomm SM7675 tablet:
+ *
+ *   vendor_kernel: failed to init default ipc namespace (-12)
+ *   -> mq_init_ns -> mq_create_mount -> fc_mount -> mqueue_fill_super
+ *
+ * The macros perturbed the VFS inode/superblock setup that mqueue performs
+ * during fc_mount(), and the mount then failed with ENOMEM. Only the extern
+ * declarations live here now; the vendor_kernel_ovl_vfs_compat.c side defines
+ * a real function with the kernel's own name for each, which every reference
+ * inside this module links to -- no static import, and no macro side effects.
+ *
+ * (Same treatment kmem_cache_alloc_lru / generic_read_dir already needed.)
+ */
+#ifndef _VNS_VFS_SHARED_SYMS_H
+#define _VNS_VFS_SHARED_SYMS_H
+
+#include <linux/version.h>
+#include <linux/types.h>
+#include <linux/fs.h>
+#include <linux/dcache.h>
+#include <linux/capability.h>
+
+/*
+ * Signatures here must match vendor_kernel_ovl_vfs_compat.c exactly: that file
+ * defines these pointers with `typeof(&name)`, so a differing declaration in
+ * this header is a type conflict on the same object, not a harmless redeclare.
+ *
+ * Two were wrong and are fixed below:
+ *   ihold()          returns void, not struct inode *
+ *   current_umask()  returns int,  not umode_t
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 10, 0) && \
+	LINUX_VERSION_CODE < KERNEL_VERSION(6, 3, 0)
+
+struct file;
+struct inode;
+struct dentry;
+struct dir_context;
+struct address_space;
+struct percpu_counter;
+struct lock_class_key;
+
+extern void (*vns_ovl_vfsc_clear_inode)(struct inode *);
+extern void (*vns_ovl_vfsc_drop_nlink)(struct inode *);
+extern void (*vns_ovl_vfsc_inc_nlink)(struct inode *);
+extern void (*vns_ovl_vfsc_set_nlink)(struct inode *, unsigned int);
+extern void (*vns_ovl_vfsc_truncate_inode_pages_final)(struct address_space *);
+extern void (*vns_ovl_vfsc_d_instantiate)(struct dentry *, struct inode *);
+extern void (*vns_ovl_vfsc_ihold)(struct inode *);
+extern void (*vns_ovl_vfsc_inode_init_once)(struct inode *);
+extern int (*vns_ovl_vfsc_current_umask)(void);
+extern int (*vns_ovl_vfsc_in_group_p)(kgid_t);
+extern void (*vns_ovl_vfsc_d_add)(struct dentry *, struct inode *);
+extern struct dentry *(*vns_ovl_vfsc_d_make_root)(struct inode *);
+extern char *(*vns_ovl_vfsc_d_path)(const struct path *, char *, int);
+
+
+/*
+ * percpu_counter_init() / percpu_counter_destroy() are NOT macro-redirected.
+ *
+ * A #define here is wrong for these two. On a !CONFIG_LOCKDEP kernel
+ * percpu_counter_init() is a static inline in <linux/percpu_counter.h> whose
+ * body was parsed long before this header, so a later #define never reaches
+ * it -- it just leaves __percpu_counter_init as a static import anyway. When
+ * the define *did* take effect it produced a call the kernel rejected:
+ *
+ *   lkm4ctr: vendor_kernel: failed to init default ipc namespace (-12)
+ *
+ * (Qualcomm SM7675 / 6.1.138, vns_msg_accounting_init -> percpu_counter_init.)
+ *
+ * Both are handled as same-name forwarding definitions in
+ * vendor_kernel_ovl_vfs_compat.c instead: a real function with the kernel's
+ * own name is reachable from already-parsed inline bodies AND from direct
+ * calls, and it emits no static import. Needed on vendor kernels that trim
+ * these exports (the Meizu 6.1.25 case), harmless where they are exported.
+ */
+#endif /* MID + OLD tier */
+
+#endif /* _VNS_VFS_SHARED_SYMS_H */
\ No newline at end of file
