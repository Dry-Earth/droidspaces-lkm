+/*
+ * kmem_cache_alloc_lru —— 6.0+ 的分配辅助，按版本分两种形态。
+ *
+ *   [6.0, 6.10)  void *kmem_cache_alloc_lru(struct kmem_cache *, struct list_lru *, gfp_t)
+ *   [6.10, ...)  void *kmem_cache_alloc_lru_noprof(...)  + 宏 kmem_cache_alloc_lru
+ *
+ * 为什么必须用同名函数而不是对象式 #define：
+ * include/linux/fs.h 里的 alloc_inode_sb() 是个 inline，它的函数体在头文件
+ * 解析时就展开了，早于我们 compat 头的 #define。所以 6.6 上加的对象式 define
+ * 根本管不到那处调用，符号照样被静态导入（CI #122 实测）。
+ *
+ * 6.10+ 那边内核自己也把 kmem_cache_alloc_lru 定义成宏，我们不能再定义同名
+ * 函数（会被宏展开成语法错误），只能用 _noprof 这个名字。
+ */
+#if VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU
+
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 10, 0)
+
+void *__nocfi kmem_cache_alloc_lru(struct kmem_cache *s, struct list_lru *lru,
+				   gfp_t gfp)
+{
+	if (!vns_ovl_vfsc_kmem_cache_alloc_lru)
+		return NULL;
+	return vns_ovl_vfsc_kmem_cache_alloc_lru(s, lru, gfp);
+}
+
+#else /* >= 6.10 */
+
+void *__nocfi kmem_cache_alloc_lru_noprof(struct kmem_cache *s,
+					  struct list_lru *lru, gfp_t gfp)
+{
+	if (!vns_ovl_vfsc_kmem_cache_alloc_lru_noprof)
+		return NULL;
+	return vns_ovl_vfsc_kmem_cache_alloc_lru_noprof(s, lru, gfp);
+}
+
+#endif /* < 6.10 */
+
+#endif /* VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU */
