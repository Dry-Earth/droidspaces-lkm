+/*
+ * 下面这批 VFS 同名转发函数三层都编译：OLD/MID/NEW 的清单里现在都有
+ * 对应的 X() 条目，指针一定存在。
+ *
+ * 为什么用同名函数而不是 #define：
+ *   - generic_read_dir 在 readdir.c 里被取地址（.read = generic_read_dir），
+ *     (*ptr) 不是编译期常量；
+ *   - 其余几个在 vendor/ipc/ 和 glue/lkm4ctr_diagfs.c 里被调用，
+ *     那些文件不在 overlayfs 的 include 链上，够不到 compat 头的 #define。
+ */
+/*
+ * The definitions below forward to pointers that exist only in the MID
+ * tier's compat list, so each is guarded exactly like that list is.
+ * Without the guard, OLD/NEW reference an undeclared vns_ovl_vfsc_* and
+ * the module fails to link -- CI #51 showed this on 5.10/5.15/6.6/6.12.
+ *
+ * The extra >= 6.0 guards mirror VNS_OVL_HAVE_KMEM_CACHE_ALLOC_LRU: those
+ * three names only entered the MID list for 6.0-and-later kernels.
+ */
+
+/*
+ * Same-name forwarding definitions for the VFS helpers in vendor/ipc/ and
+ * glue/lkm4ctr_diagfs.c call.
+ *
+ * These were #define aliases in vns_vfs_shared_syms.h. That is fine in
+ * isolation but broke lkm4ctr on the Qualcomm SM7675 tablet: mq_init_ns()
+ * failed with -ENOMEM inside mq_create_mount() -> fc_mount() ->
+ * mqueue_fill_super(), whose inode setup runs right through these names.
+ *
+ * A real function with the kernel's own name has none of the macro's reach:
+ * every reference inside this module links here, no static import is emitted,
+ * and the call shape is exactly what the kernel expects.
+ *
+ * All are __nocfi: the bodies make indirect calls, and CONFIG_CFI_CLANG checks
+ * those at the call site.
+ */
+
+__nocfi void clear_inode(struct inode *inode)
+{
+	if (vns_ovl_vfsc_clear_inode)
+		vns_ovl_vfsc_clear_inode(inode);
+}
+
+__nocfi void drop_nlink(struct inode *inode)
+{
+	if (vns_ovl_vfsc_drop_nlink)
+		vns_ovl_vfsc_drop_nlink(inode);
+}
+
+__nocfi void inc_nlink(struct inode *inode)
+{
+	if (vns_ovl_vfsc_inc_nlink)
+		vns_ovl_vfsc_inc_nlink(inode);
+}
+
+__nocfi void set_nlink(struct inode *inode, unsigned int nlink)
+{
+	if (vns_ovl_vfsc_set_nlink)
+		vns_ovl_vfsc_set_nlink(inode, nlink);
+}
+
+__nocfi void d_instantiate(struct dentry *dentry, struct inode *inode)
+{
+	if (vns_ovl_vfsc_d_instantiate)
+		vns_ovl_vfsc_d_instantiate(dentry, inode);
+}
+
+__nocfi void ihold(struct inode *inode)
+{
+	if (vns_ovl_vfsc_ihold)
+		vns_ovl_vfsc_ihold(inode);
+}
+
+__nocfi void inode_init_once(struct inode *inode)
+{
+	if (vns_ovl_vfsc_inode_init_once)
+		vns_ovl_vfsc_inode_init_once(inode);
+}
+
+__nocfi int current_umask(void)
+{
+	if (!vns_ovl_vfsc_current_umask)
+		return 0;
+	return vns_ovl_vfsc_current_umask();
+}
+
+__nocfi int in_group_p(kgid_t gid)
+{
+	if (!vns_ovl_vfsc_in_group_p)
+		return 0;
