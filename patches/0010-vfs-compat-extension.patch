  * splice_read()/splice_write()/mmap(), later moved to its own
@@ -465,6 +504,9 @@ static inline void generic_fill_statx_attr(struct inode *inode, struct kstat *st
 	X(override_creds)
 #endif
 #define VNS_OVL_VFS_COMPAT_LIST(X) \
+	VNS_OVL_VFSC_KMLRU_NO_PROF_ENTRY(X) \
+	VNS_OVL_VFSC_KMLRU_PROF_ENTRY(X) \
+	X(finish_open) \
